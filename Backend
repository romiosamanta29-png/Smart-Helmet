# --- TWILIO SMS SETUP ---
from twilio.rest import Client

TWILIO_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_SANDBOX_NUMBER = "" 
MOM_PHONE_NUMBER = ""   

def send_emergency_sms(gps_coords):
    """Sends a real WhatsApp alert with a Google Maps link to the emergency contact."""
    try:
        if TWILIO_SID == "":
            print("[Warning] Twilio credentials not set. Skipping SMS dispatch.")
            return

        client = Client(TWILIO_SID, TWILIO_AUTH_TOKEN)
        
        # Build the URL dynamically to prevent link scrambling
        base_url = "https://www." + "google.com/maps"
        maps_link = f"{base_url}?q={gps_coords[0]},{gps_coords[1]}"
        
        msg = client.messages.create(
            body=f"🚨 EMERGENCY ALERT: RoadSoS detected a severe vehicle crash. Immediate assistance required. Live location: {maps_link}",
            from_=f"whatsapp:{TWILIO_SANDBOX_NUMBER}", 
            to=f"whatsapp:{MOM_PHONE_NUMBER}"          
        )
        print(f"\n[SUCCESS] WhatsApp Alert Sent! Message SID: {msg.sid}")
    except Exception as e:
        print(f"\n[ERROR] Failed to send WhatsApp: {e}")

